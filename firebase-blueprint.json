{
  "entities": {
    "User": {
      "title": "User",
      "description": "App user with role-based permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "seller", "admin"] },
        "status": { "type": "string", "enum": ["active", "banned"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "email", "role", "status"]
    },
    "Car": {
      "title": "Car",
      "description": "Vehicle listing",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "year": { "type": "integer" },
        "mileage": { "type": "integer" },
        "transmission": { "type": "string", "enum": ["manual", "automatic"] },
        "fuel": { "type": "string", "enum": ["gasoline", "diesel", "electric", "hybrid"] },
        "color": { "type": "string" },
        "doors": { "type": "integer" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "condition": { "type": "string", "description": "Seller appraisal of condition" },
        "images": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["available", "reserved", "sold"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sellerId", "brand", "model", "year", "price", "status"]
    },
    "Reservation": {
      "title": "Reservation",
      "description": "Vehicle reservation by a client",
      "type": "object",
      "properties": {
        "carId": { "type": "string" },
        "clientId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "expired", "cancelled", "completed"] }
      },
      "required": ["carId", "clientId", "expiresAt", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Car feedback from clients",
      "type": "object",
      "properties": {
        "carId": { "type": "string" },
        "clientId": { "type": "string" },
        "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["carId", "clientId", "rating"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "Client's favorite listings",
      "type": "object",
      "properties": {
        "carId": { "type": "string" },
        "clientId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["carId", "clientId"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Users of the platform"
    },
    "cars/{carId}": {
      "schema": "Car",
      "description": "Vehicle inventory"
    },
    "cars/{carId}/reservations/{reservationId}": {
      "schema": "Reservation",
      "description": "History of reservations for a car"
    },
    "users/{userId}/favorites/{favoriteId}": {
      "schema": "Favorite",
      "description": "User's favorited cars"
    },
    "reviews/{reviewId}": {
      "schema": "Review",
      "description": "Global car reviews"
    }
  }
}
